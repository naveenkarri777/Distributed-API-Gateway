# Environment variables for the API Gateway
# Copy this file to .env and adjust values as needed.

GATEWAY_PORT=3000

# Backend Microservice URLs
USER_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Rate Limiting Algorithm (Phase 5)
# Options: fixed-window | sliding-window | token-bucket
RATE_LIMIT_ALGORITHM=fixed-window

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Phase 6: Reliability
PROXY_TIMEOUT_MS=3000
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
